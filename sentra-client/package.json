{
  "name": "sentra-connect",
  "version": "1.0.0",
  "description": "Sentra Connect - Next-Generation Anti-Censorship Client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite . --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npx --yes tsx --test src/utils/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "tauri": "npx --yes @tauri-apps/cli@2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
