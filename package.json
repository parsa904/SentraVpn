{
  "name": "sentra-platform",
  "version": "1.0.0",
  "description": "Sentra Connect - Anti-Censorship Network Platform",
  "private": true,
  "workspaces": [
    "sentra-client"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node server.ts",
    "build": "npm run build --workspace=sentra-connect",
    "typecheck": "npm run typecheck --workspace=sentra-connect",
    "lint": "npm run lint --workspace=sentra-connect",
    "test": "npm run test --workspace=sentra-connect && node --experimental-strip-types --test cloudflare-worker/src/__tests__/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "npm run preview --workspace=sentra-connect"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "d3": "^7.9.2",
    "express": "^5.3.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^5.4.21",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^2.0.0"
  }
}
