{
  "name": "sentra-cloudflare-worker",
  "version": "1.0.0",
  "description": "Sentra Platform Serverless Core, Sing-box 1.14+ Compiler & Telegram Webhook on Cloudflare Workers + D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/__tests__/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply sentra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sentra-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.14.0"
  }
}
