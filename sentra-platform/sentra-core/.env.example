# ==============================================================================
# Sentra Platform - Core Backend & Telegram Bot Environment Configuration
# ==============================================================================

# REST API Server Configuration
PORT=8080
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:8080

# SQLite Database Connection String (WAL mode auto-enabled)
DATABASE_URL=sqlite://sentra_local.db?mode=rwc

# Telegram Bot API Token (Obtained from @BotFather)
TELOXIDE_TOKEN=123456789:AAE0QjV97HS-wH55nbVsHA2ADZOLrNcKzrE

# Proxy configuration for Telegram Bot (Crucial for dev environments in Iran)
# Supports SOCKS5 and HTTP/HTTPS proxies:
# e.g., socks5://127.0.0.1:10808 or http://127.0.0.1:10809
# Leave empty if connecting directly or in unblocked server environments.
TELOXIDE_PROXY=socks5://127.0.0.1:12334

# Super Admin Telegram Chat ID (Numeric ID, e.g. from @userinfobot)
# Grants exclusive access to the hidden Sentra Admin Dashboard and 6-layer health checks
ADMIN_CHAT_ID=6294857996

# Logging & Diagnostic Filter
RUST_LOG=info,sentra_core=debug
